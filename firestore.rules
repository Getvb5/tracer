rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Global helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email.matches('(?i)^.*(admin|gestao|qualidade|getvb98@gmail.com|saude.recife.pe.gov.br).*$') ||
        request.auth.token.email == 'getvb98@gmail.com'
      );
    }

    // Audits - Hand Hygiene
    match /audits_hand_hygiene/{id} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isSignedIn();
    }

    // Audits - Patient ID
    match /audits_patient_id/{id} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isSignedIn();
    }

    // Audits - Safe Surgery
    match /audits_safe_surgery/{id} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isSignedIn();
    }

    // Escalas OSS
    match /escalas_oss/{id} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Units
    match /units/{id} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Auditors
    match /auditors/{id} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Test connectivity
    match /test/{id} {
      allow read, write: if true;
    }

    // System configuration (Webhooks, app settings)
    match /system_config/{id} {
      allow read: if true;
      allow write: if true;
    }
  }
}

